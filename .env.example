# Il file .env vero viene creato da deploy/setup.sh con una password generata.
DATABASE_URL=postgres://vigil:PASSWORD@127.0.0.1:5432/vigil

# Ogni quanti secondi il worker pinga tutti gli host
PING_INTERVAL_SECONDS=10
# Cicli falliti di fila prima di dichiarare un host offline
OFFLINE_AFTER_FAILURES=2
# Ogni quanti secondi si controllano porte, siti e certificati
CHECK_INTERVAL_SECONDS=30
# Ogni quanti secondi si registra la salute del server
SERVER_SAMPLE_SECONDS=60

# Ogni 14 giorni si cancellano i dati più vecchi di 7 giorni (la prima settimana)
RETENTION_CYCLE_DAYS=14
RETENTION_KEEP_DAYS=7

# Indirizzo del link «Codice sorgente». Se hai modificato Vigil, o se la rete non
# raggiunge internet, indica la tua copia del sorgente (AGPL, sezione 13).
# SOURCE_URL=https://github.com/TumasDevelopment/Vigil
